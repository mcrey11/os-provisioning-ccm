# Configuration file for module ProvVoip

# the minimal time to wait before deactivation and reassignment of a phonenumber; e.g. 6M or 2Y
# WARNING: This only works for phonenumbers having a PhonenumberManagement with correctly
# filled deactivation_date!
MIN_TIME_TO_WAIT_BETWEEN_PHONENUMBER_DEACTIVATION_AND_REASSIGNMENT=24M
