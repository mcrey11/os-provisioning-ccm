# Configuration file for module ProvBase

# Configuration for database used by radius
RADIUS_DB_HOST=localhost
RADIUS_DB_DATABASE=radius
RADIUS_DB_USERNAME=radius
RADIUS_DB_PASSWORD=

# Configuration for database used by kea
KEA_DB_HOST=localhost
KEA_DB_DATABASE=kea
KEA_DB_USERNAME=kea
KEA_DB_PASSWORD=

# use CWMP connection requests instead of waiting on next Inform to perform task
CWMP_CONNECTION_REQUEST=1
# in miliseconds
CWMP_CONNECTION_REQUEST_TIMEOUT=3000

# comma-separated event(s) to execute monitoring provision on
# 0 BOOTSTRAP
# 1 BOOT
# 2 PERIODIC
# 3 SCHEDULED
# 4 VALUE CHANGE
# 5 KICKED
# 6 CONNECTION REQUEST
# 7 TRANSFER COMPLETE
# 8 DIAGNOSTICS COMPLETE
# 9 REQUEST DOWNLOAD
# 10 AUTONOMOUS TRANSFER COMPLETE
# 11 DU STATE CHANGE COMPLETE
# 12 AUTONOMOUS DU STATE CHANGE COMPLETE
# 13 WAKEUP
# (typically 2 or 2,6)
CWMP_MONITORING_EVENTS=2

# defines status thresholds for e.g. coloring of CM
# two formats (two and four comma separated values):
#   red_VALUE1_yellow_VALUE2_green
#   red_VALUE1_yellow_VALUE2_green_VALUE3_yellow_VALUE4
# use decimal points as decimal separator (e.g. 1.5) and comma to separate values
#
# remember to run
# php /var/www/nmsprime/artisan config:cache
# to see the changes
STATUS_THRESHOLDS_AVG_UTILIZATION="0, 0, 70, 90"
STATUS_THRESHOLDS_DOCSIS_DS_PWR="-20, -10, 15, 20"
STATUS_THRESHOLDS_DOCSIS_DS_US="-12, -5, 5, 12"
STATUS_THRESHOLDS_DOCSIS_MICREF="20, 30"
STATUS_THRESHOLDS_DOCSIS_RX_PWR="-3, -1, 15, 20"
STATUS_THRESHOLDS_DOCSIS_US_PWR="22, 27, 50, 56"
STATUS_THRESHOLDS_DOCSIS_SNR_QPSK="14, 17"
STATUS_THRESHOLDS_DOCSIS_SNR_QAM16="20, 23"
STATUS_THRESHOLDS_DOCSIS_SNR_QAM32="22, 25"
STATUS_THRESHOLDS_DOCSIS_SNR_QAM64="26, 29"
STATUS_THRESHOLDS_DOCSIS_SNR_QAM256="32, 35"
