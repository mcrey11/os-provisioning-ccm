{
    "preset": "laravel",
    "rules": {
        "binary_operator_spaces": false,
        "fully_qualified_strict_types": {
            "import_symbols": false
        },
        "operator_linebreak": {
            "only_booleans": true,
            "position": "end"
        },
        "phpdoc_summary": false
    },
    "exclude": [
        "public",
        "public-ccc",
        "resources/lang",
        "storage",
        "vendor",
        "vendors"
    ],
    "notName": ["*.blade.php"]
}
